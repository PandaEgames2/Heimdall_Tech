# Genera una clave real con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# En producción usa DJANGO_DEBUG=False; la aplicación rechaza claves de ejemplo.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Opcionales para acceso desde la LAN o producción:
# DJANGO_CORS_ALLOWED_ORIGINS=http://192.168.1.50:5173
# DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.50:5173
# DJANGO_BEHIND_PROXY=False
# JWT_ACCESS_MINUTES=15
# JWT_REFRESH_DAYS=7
# REFRESH_TOKEN_COOKIE_NAME=heimdall_refresh
# HEIMDALL_DEMO_PASSWORD=Heimdall#2026

# La base debe tener el esquema de Heimdall_Tech.sql. En una instalación nueva,
# impórtalo una sola vez con `python backend/bootstrap_db.py --execute`.
# `iniciar.ps1` verifica las tablas base, migra Django y sincroniza el RBAC de
# cinco tablas sin borrar datos existentes.
DB_NAME=heimdall_tech
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
